# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration
# Get connection string from MongoDB Atlas: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database?appName=app

# JWT Configuration
# IMPORTANT: Generate a strong secret key
# You can generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-here-min-32-characters

# Frontend URL for CORS
# Should match your production frontend domain
FRONTEND_URL=https://your-production-domain.com

# Google OAuth Web Client ID
# Get from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Truecaller OAuth Credentials
# Get from: https://developer.truecaller.com/
TRUECALLER_CLIENT_ID=your-truecaller-client-id
TRUECALLER_CLIENT_SECRET=your-truecaller-client-secret

